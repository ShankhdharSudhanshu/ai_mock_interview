# ── Supabase ─────────────────────────────────────────────────────
# Project was deleted/paused. Leave blank to run in demo mode.
# To use Supabase: create a new project at https://supabase.com and paste your credentials here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── MongoDB ───────────────────────────────────────────────────────
# Get a free URI from: https://cloud.mongodb.com → New Project → Free Cluster → Connect → Copy URI
# Format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/voiceprep?retryWrites=true&w=majority
MONGODB_URI=

# Service Role Key (server-side only, never expose client-side)
# Get from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI (optional — uses mock if blank) ───────────────────────
OPENAI_API_KEY=

# ── Stripe (optional) ────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
